# ==========================================================================
# Elite Publishing — routing, compression, caching, security headers
# ==========================================================================

Options -Indexes
DirectoryIndex index.php

# --- Pretty URLs ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /services/ghostwriting  ->  service.php?s=ghostwriting
  RewriteRule ^services/([a-z0-9-]+)/?$ service.php?s=$1 [L,QSA]

  # Generated sitemap, served at the conventional path
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Campaign landing pages.
  #
  # lp1-lp4 are now self-contained directories, each with its own index.php,
  # so /lp1/ .. /lp4/ are served by DirectoryIndex and need no rule at all.
  # A request for /lp1 (no slash) is redirected to /lp1/ by mod_dir, and the
  # extensionless and 404 rules below both skip real directories.
  #
  # This REPLACES a `RewriteRule ^lp[1-4](\.php)?/?$ / [R=301,L]` that sent
  # every one of these URLs to the home page. It was correct while the pages
  # were deleted and it is wrong now — with it in place the landing pages are
  # unreachable, and a 301 is cached hard by browsers, so anyone who hit an LP
  # URL while that rule was live keeps getting bounced to the home page until
  # their cache expires. Test in a private window.
  #
  # The old flat URLs (/lp1.php, and /lp1 as it was published before the pages
  # became directories) still exist in live ads and in the index, so they are
  # forwarded to the directory rather than dropped.
  #
  # The target is root-absolute because this site deploys to a domain root. A
  # relative target is NOT the portable fix, and this was re-tested rather than
  # assumed: without a RewriteBase, mod_rewrite resolves `lp$1/` against the
  # filesystem directory and emits
  # "http://host/F:/xampp/htdocs/Elite Publishing/lp1/" in the Location header.
  # If this ever runs from a sub-directory, set RewriteBase to that directory
  # rather than editing this line.
  #
  # Consequence worth knowing while testing locally under XAMPP: /lp1.php
  # redirects to /lp1/ at the server root, which is a 404 there. The
  # directories themselves (/Elite Publishing/lp1/) work correctly, and on the
  # live domain both forms are right.
  RewriteRule ^lp([1-4])\.php$ /lp$1/ [R=301,L]

  # The one page whose spec'd URL differs from its filename (SPEC §F.3).
  # The generic extensionless rule below only finds same-named files, so
  # without this /about-our-company 404s.
  RewriteRule ^about-our-company/?$ about.php [L,QSA]

  # Allow extensionless page URLs (/about -> about.php)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# --- Caching --------------------------------------------------------------
# MAIN-SITE assets are requested with a ?v=<mtime> query string (see asset() in
# includes/functions.php), so a long max-age is safe for them: the URL changes
# whenever the file does.
#
# The landing pages USED to be the exception. They arrived as standalone
# projects and linked their own CSS and JS with plain relative paths —
# "assets/css/landing.css" with no version — so their URLs never changed when
# the file did. Serving those as immutable for a year means a fixed stylesheet
# never reaches anyone who has already visited: their browser has been told,
# truthfully, that it need not ask again until 2027. That is not hypothetical —
# it hid a footer fix during testing, and later a pricing-card fix, in both
# cases until the cache was bypassed by hand.
#
# The short cache below was the mitigation. The cure is ep_lp_asset() in
# includes/lp-bootstrap.php, which the four pages now use for every stylesheet
# and script: it appends the file's mtime, so the URL changes whenever the file
# does, exactly as asset() has always done for the main site.
#
# The 3600 is therefore no longer load-bearing and could be deleted — the URLs
# are self-versioning now. It is kept as a belt-and-braces guard for any asset
# under lp1..lp4 that is still referenced with a bare path: the LP stylesheets
# reference their own images and fonts by relative URL from inside the CSS, and
# those are not rewritten by anything. An hour is a reasonable ceiling on how
# long a swapped hero image can stay stale.
#
# The SetEnvIf below tags LP assets and the second Header line in the
# mod_headers block overrides the immutable one for anything tagged. Both Header
# lines sit in the SAME container on purpose: a later directive only reliably
# overrides an earlier one within one container.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "(^|/)lp[1-4]/" EP_LP_ASSET=1
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    # Landing page assets carry no ?v= in their URLs — see the note above.
    Header set Cache-Control "public, max-age=3600" env=EP_LP_ASSET
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Security headers ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always unset X-Powered-By
</IfModule>

# --- MIME types -----------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType font/woff2  .woff2
</IfModule>

# --- Block access to internals -------------------------------------------
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env|.*\.md)$">
  Require all denied
</FilesMatch>

# tools/ holds the CLI image builders and "Elite Publishing -fgma-images" holds
# 108MB of raw Figma exports. Neither belongs on a web server at all — see
# README "What not to upload" — but a rule costs nothing and a folder that was
# reachable at 200 is exactly the kind of thing that gets re-uploaded by a
# drag-and-drop deploy later. The space in the folder name is intentional.
<IfModule mod_rewrite.c>
  RewriteRule ^(includes|data|docs|tools|_figma-ref)/ - [F,L]
  RewriteRule ^Elite\ Publishing\ -fgma-images/ - [F,L]

  # The landing pages arrived as standalone project folders, so each one
  # carries its own build scaffolding: lp4/tools/ (a Node build script and its
  # lockfile), lp4/docs/, and the .claude/ and .editorconfig files the pages
  # were authored with. None of it is needed to serve a page and none of it
  # should be readable. The root rules above only match at the root, so the
  # same folders one level down need saying again.
  RewriteRule ^lp[1-4]/(tools|docs|\.claude)/ - [F,L]

  # Any dotfile, at any depth — .gitignore, .editorconfig, .env, and anything
  # else that starts with a dot and was never meant to be fetched.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# --- 404 ------------------------------------------------------------------
# ErrorDocument takes a URL path, not a filesystem path, so it cannot be
# written once for both a sub-directory install and a domain root. Routing the
# miss through mod_rewrite instead keeps it correct in both.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

# Fallback for servers without mod_rewrite. Correct at a domain root; update
# the path if the site is deployed into a sub-directory.
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /404.php
</IfModule>

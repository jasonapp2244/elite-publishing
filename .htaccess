# ==========================================================================
# Elite Publishing — routing, compression, caching, security headers
# ==========================================================================

Options -Indexes
DirectoryIndex index.php

# --- Pretty URLs ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /services/ghostwriting  ->  service.php?s=ghostwriting
  RewriteRule ^services/([a-z0-9-]+)/?$ service.php?s=$1 [L,QSA]

  # Generated sitemap, served at the conventional path
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # The one page whose spec'd URL differs from its filename (SPEC §F.3).
  # The generic extensionless rule below only finds same-named files, so
  # without this /about-our-company 404s.
  RewriteRule ^about-our-company/?$ about.php [L,QSA]

  # Allow extensionless page URLs (/about -> about.php)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# --- Caching --------------------------------------------------------------
# Assets are requested with a ?v=<mtime> query string, so a long max-age is safe.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Security headers ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always unset X-Powered-By
</IfModule>

# --- MIME types -----------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType font/woff2  .woff2
</IfModule>

# --- Block access to internals -------------------------------------------
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env|.*\.md)$">
  Require all denied
</FilesMatch>

# tools/ holds the CLI image builders and "Elite Publishing -fgma-images" holds
# 108MB of raw Figma exports. Neither belongs on a web server at all — see
# README "What not to upload" — but a rule costs nothing and a folder that was
# reachable at 200 is exactly the kind of thing that gets re-uploaded by a
# drag-and-drop deploy later. The space in the folder name is intentional.
<IfModule mod_rewrite.c>
  RewriteRule ^(includes|data|docs|tools|_figma-ref)/ - [F,L]
  RewriteRule ^Elite\ Publishing\ -fgma-images/ - [F,L]
</IfModule>

# --- 404 ------------------------------------------------------------------
# ErrorDocument takes a URL path, not a filesystem path, so it cannot be
# written once for both a sub-directory install and a domain root. Routing the
# miss through mod_rewrite instead keeps it correct in both.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

# Fallback for servers without mod_rewrite. Correct at a domain root; update
# the path if the site is deployed into a sub-directory.
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /404.php
</IfModule>
